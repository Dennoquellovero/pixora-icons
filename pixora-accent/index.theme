[Icon Theme]
Name=Pixora Accent
Comment=Pixora folders that follow the KDE accent color
Inherits=pixora,breeze,hicolor
FollowsColorScheme=true
Directories=scalable/apps,scalable/places,scalable/categories,scalable/mimetypes,scalable/actions

[scalable/apps]
Size=16
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512

[scalable/places]
Size=16
Context=Places
Type=Scalable
MinSize=8
MaxSize=512

[scalable/categories]
Size=16
Context=Categories
Type=Scalable
MinSize=8
MaxSize=512

[scalable/mimetypes]
Size=16
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=512

[scalable/actions]
Size=16
Context=Actions
Type=Scalable
MinSize=8
MaxSize=512
